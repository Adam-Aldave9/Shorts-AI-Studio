# Copy to .env and fill in. docker-compose reads this file automatically.

# LLM (planning tier)
ANTHROPIC_API_KEY=
# or OPENAI_API_KEY=

# Media generation
FAL_API_KEY=
ELEVENLABS_API_KEY=

# Infrastructure (defaults match docker-compose service names)
REDIS_URL=redis://redis:6379/0
POSTGRES_URL=postgresql://afp:afp@postgres:5432/afp
S3_ENDPOINT=http://minio:9000
S3_BUCKET=film-assets

# Service URLs (frontend build-time + scheduler runtime)
PLANNING_URL=http://planning:8000
SCHEDULER_URL=http://scheduler:8001
VITE_PLANNING_URL=http://localhost:8000
VITE_SCHEDULER_URL=http://localhost:8001

# Mode
MOCK=false
WORKER_CONCURRENCY=4
