# Copy to .env and fill in. docker-compose reads this file automatically.

# LLM (planning tier)
ANTHROPIC_API_KEY=
# or OPENAI_API_KEY=

# Media generation
FAL_API_KEY=
ELEVENLABS_API_KEY=

# Infrastructure (defaults match docker-compose service names)
REDIS_URL=redis://redis:6379/0
POSTGRES_URL=postgresql://afp:afp@postgres:5432/afp
S3_ENDPOINT=http://minio:9000
S3_BUCKET=film-assets

# Service URLs (frontend build-time + scheduler runtime)
PLANNING_URL=http://planning:8000
SCHEDULER_URL=http://scheduler:8001
# The SPA now talks to both APIs same-origin through the reverse proxy (nginx in
# prod, the Vite dev-server proxy in dev), so cookies are first-party. These paths are
# proxied to planning:8000 / scheduler:8001 — do not point them back at the raw ports.
VITE_PLANNING_URL=/api/planning
VITE_SCHEDULER_URL=/api/scheduler

# Auth (accounts + session-based login). SECRET_KEY is REQUIRED — the services fail
# fast without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Set true in production (HTTPS) so cookies are Secure; false for local http dev.
COOKIE_SECURE=false
# Origins allowed for credentialed CORS + the CSRF Origin check (comma-separated).
AUTH_ALLOWED_ORIGINS=http://localhost:5173
# Session lifetimes (seconds): sliding idle window + absolute cap.
SESSION_IDLE_TTL=1800
SESSION_ABSOLUTE_TTL=43200

# Mode
MOCK=false
WORKER_CONCURRENCY=4
