{
  "name": "afp-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI Film Pipeline internal tool: submit briefs, review/edit packages, monitor execution, play the final cut.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/api/planning.d.ts && openapi-typescript http://localhost:8001/openapi.json -o src/api/scheduler.d.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.11.0",
    "knip": "^5.36.0",
    "openapi-typescript": "^6.7.6",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.2.13"
  }
}
