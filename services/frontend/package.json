{
  "name": "afp-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI Film Pipeline internal tool: submit briefs, review/edit packages, monitor execution, play the final cut.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/api/planning.d.ts && openapi-typescript http://localhost:8001/openapi.json -o src/api/scheduler.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "openapi-typescript": "^6.7.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.13"
  }
}
